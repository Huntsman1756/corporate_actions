# raw corpus: nunca se commitea cuando la fuente no permite redistribucion.
/raw/
g0/corpus/raw/*
!g0/corpus/raw/.gitkeep
g1/corpus/raw/*
!g1/corpus/raw/.gitkeep
g1r/corpus/raw/*
!g1r/corpus/raw/.gitkeep

# outputs regenerables de un run (se recrean; Phase H los borra)
g0/results/*.json
!g0/results/.gitkeep
g1/results/*.json
!g1/results/.gitkeep
g1r/results/*.json
!g1r/results/.gitkeep
# artefactos congelados G1-R: baseline c431830 sobre DEV se commitea
!g1r/results/baseline-c431830-results.json
!g1r/results/dev-failure-catalog.json
# artefactos congelados G1 (ADR-015): baseline y final DEV se commitean
!g1/results/first-run-results.json
!g1/results/final-run-results.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
