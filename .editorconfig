root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Evidencia congelada / corpus fijado por sha256: los editores no deben
# normalizar finales de linea ni espacios al editar estos ficheros.
[{g0,g1,g1r,g1r2,g2,g3,p1}/**,*.fin]
insert_final_newline = false
trim_trailing_whitespace = false
